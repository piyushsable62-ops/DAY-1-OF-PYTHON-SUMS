class Vector:
    def __init__(self, l):
        self.x = l[0]
        self.y = l[1]
        self.z = l[2]

    def __add__(self, other):
        result = Vector([
            self.x + other.x,
            self.y + other.y,
            self.z + other.z
        ])
        return result

    def __mul__(self, other):
        result = self.x * other.x + self.y * other.y + self.z * other.z
        return result

    def __str__(self):
        return f"Vector({self.x}, {self.y}, {self.z})"

    def __len__(self):
        return 3



v1 = Vector([1, 2, 3])
v2 = Vector([4, 5, 6])

print(v1)          
print(v2)          

print(v1 + v2)     
print(v1 * v2)     # 32

print(len(v1))     # 3
