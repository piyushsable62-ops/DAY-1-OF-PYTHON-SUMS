
class Complex:
    def __init__(self, r, i):
        self.r = r
        self.i = i

    def __add__(self, c2):
        return Complex(self.r + c2.r, self.i + c2.i)

    def __mul__(self, c2):
        real_part = self.r * c2.r - self.i * c2.i
        imag_part = self.r * c2.i + self.i * c2.r
        return Complex(real_part, imag_part)

    def __str__(self):
        return f"{self.r} + {self.i}i"



c1 = Complex(1, 2)
c2 = Complex(3, 4)

print("Addition:", c1 + c2)
print("Multiplication:", c1 * c2)



 # multiple and multilevel inhertitance



class employee:
    company = "google"
    name = "piyush"
    def see(self):
        print(f"{self.name} is placed in {self.company}")

class coder:
    language = "pythonnjava"
    def printlanguage(self):
        print(f"{self.name} know {self.language} language")


class programmer(employee,coder):
    company = "faang"
    name = "piyush"
    def show(self):
        print(f"{self.name} placed in {self.company}")

a = employee()
b = programmer()
b.show()
b.printlanguage()
b.see()





